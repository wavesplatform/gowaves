{-# STDLIB_VERSION 6 #-}
{-# CONTENT_TYPE DAPP #-}
{-# SCRIPT_TYPE ACCOUNT #-}

# Synthetic dApp with many match/case expressions over union types.

func classify(k: String) = match getInteger(this, k) {
  case n: Int => n
  case _ => match getString(this, k) {
    case s: String => size(s)
    case _ => match getBoolean(this, k) {
      case b: Boolean => if (b) then 1 else 0
      case _ => -1
    }
  }
}

@Callable(i)
func m0() = {
  let p = match i.payments[0].assetId {
    case a: ByteVector => toBase58String(a)
    case _ => "WAVES"
  }
  let c = classify(p) + classify("k0")
  let r = match getBinary(this, p) {
    case b: ByteVector => size(b) + c
    case _ => c
  }
  [IntegerEntry(p, r)]
}

