@Verifier(tx)
func verify() = match tx {
  case t: TransferTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: MassTransferTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: IssueTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: ReissueTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: BurnTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: LeaseTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: LeaseCancelTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: CreateAliasTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: DataTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: SetScriptTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: SponsorFeeTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: ExchangeTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: InvokeScriptTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case t: SetAssetScriptTransaction => classify(toBase58String(t.id)) > 0 && sigVerify(t.bodyBytes, t.proofs[0], t.senderPublicKey)
  case _ => false
}
