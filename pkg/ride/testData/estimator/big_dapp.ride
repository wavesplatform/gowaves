func f0(a: Int) = a + 1
func f1(a: Int) = if (a > 1) then f0(a - 1) else a + 1
func f2(a: Int) = if (a > 2) then f1(a - 1) else a + 2
func f3(a: Int) = if (a > 3) then f2(a - 1) else a + 3
