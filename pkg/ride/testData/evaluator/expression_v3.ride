{-# STDLIB_VERSION 3 #-}
{-# CONTENT_TYPE EXPRESSION #-}
{-# SCRIPT_TYPE ACCOUNT #-}

# Synthetic legacy expression verifier for the evaluator benchmarks.

func level(i: Int) =
  if (i < 10) then 0
  else if (i < 100) then 1
  else if (i < 1000) then 2
  else if (i < 10000) then 3
  else 4

match tx {
  case t: TransferTransaction =>
    let a = t.amount
    let f = size(t.id) * 1000
    let l = level(a) + level(f) + level(a + f) + level(a * 2) + level(f * 3)
    let att = match t.attachment {
      case b: ByteVector => size(b)
      case _ => 0
    }
    let s = att + size(t.id) + size(t.senderPublicKey)
    a > 0 && f > 0 && l >= 0 && s > 0 && height > 0
  case _ => false
}
